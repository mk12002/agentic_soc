# =============================================================================
# SOC platform configuration. Copy to .env and fill in. NEVER commit .env.
# In production, inject secrets from a vault (Azure Key Vault): any SOC_* secret
# can instead be supplied as <NAME>_FILE pointing at a mounted secret file.
# =============================================================================

# --- platform ---------------------------------------------------------------
SOC_ENVIRONMENT=dev                      # dev | test | prod
SOC_DATABASE_URL=sqlite:///./data/soc_platform.db
# SOC_DATABASE_URL=postgresql+psycopg2://soc:<password>@postgres:5432/soc_platform
SOC_CONNECTORS_CONFIG=config/connectors.yaml
SOC_CONNECTOR_MODE=fake                  # fake (fixtures) | live - per-connector override in connectors.yaml
SOC_ORG_DOMAINS=cci-demo.com             # comma-separated internal mail domains
SOC_RAW_PAYLOAD_DIR=./data/raw
SOC_REPORT_OUTPUT_DIR=./data/reports
SOC_PHISHING_ENGINE=0                    # 1 = also run the 7-agent ML swarm (needs requirements/phishing.txt)
SOC_KILL_SWITCH=false

# --- identity (NFR-09) -------------------------------------------------------
SOC_AUTH_MODE=dev                        # dev (HS256 test tokens) | entra (SSO)
SOC_DEV_JWT_SECRET=change-me-to-a-long-random-string
SOC_ENTRA_TENANT_ID=
SOC_ENTRA_AUDIENCE=                      # api://<app-id> of the platform API registration

# --- LLM (optional; everything works without it) ------------------------------
SOC_LLM_PROVIDER=none                    # none | azure_openai
SOC_LLM_ENDPOINT=                        # https://<resource>.openai.azure.com
SOC_LLM_DEPLOYMENT=                      # large model deployment (complex reasoning)
SOC_LLM_DEPLOYMENT_SMALL=                # small model deployment (routine narrative)
SOC_LLM_API_KEY=
SOC_LLM_MODEL_VERSION=                   # pinned model version (change-controlled)
SOC_LLM_APPROVED_ENDPOINTS=              # comma-separated allow-list
SOC_LLM_MONTHLY_TOKEN_BUDGET=5000000

# --- docker compose ------------------------------------------------------------
POSTGRES_USER=soc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=soc_platform
RABBITMQ_USER=soc
RABBITMQ_PASSWORD=change-me

# --- connector credentials (only for mode: live; see config/connectors.yaml) ----
# CROWDSTRIKE_CLIENT_ID= / CROWDSTRIKE_CLIENT_SECRET= / CROWDSTRIKE_BASE_URL=
# DEFENDER_ENDPOINT_TENANT_ID= / DEFENDER_ENDPOINT_CLIENT_ID= / DEFENDER_ENDPOINT_CLIENT_SECRET=
# DEFENDER_OFFICE365_TENANT_ID= / ..._CLIENT_ID= / ..._CLIENT_SECRET= / DEFENDER_OFFICE365_REPORTING_MAILBOX=
# ENTRA_TENANT_ID= / ENTRA_CLIENT_ID= / ENTRA_CLIENT_SECRET=
# RAPID7_CONSOLE_URL= / RAPID7_USERNAME= / RAPID7_PASSWORD=
# WIZ_API_URL= / WIZ_CLIENT_ID= / WIZ_CLIENT_SECRET=
# AVANAN_CLIENT_ID= / AVANAN_ACCESS_KEY=
# UMBRELLA_API_KEY= / UMBRELLA_API_SECRET= / UMBRELLA_BLOCK_LIST_ID=
# CANARY_DOMAIN_HASH= / CANARY_AUTH_TOKEN=
# DELINEA_SECRET_SERVER_BASE_URL= / ..._USERNAME= / ..._PASSWORD=
# DELINEA_PRIVILEGE_MANAGER_BASE_URL= / ..._CLIENT_ID= / ..._CLIENT_SECRET=
# SERVICENOW_INSTANCE_URL= / SERVICENOW_CLIENT_ID= / SERVICENOW_CLIENT_SECRET=
# THREAT_INTEL_VIRUSTOTAL_API_KEY= / THREAT_INTEL_ABUSEIPDB_API_KEY= / THREAT_INTEL_OTX_API_KEY= ...
# NVD_API_KEY=

# =============================================================================
# Phishing ML engine (legacy service settings, used by the 'engine' compose profile)
# =============================================================================
APP_ENV=development
APP_LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=logs/
API_AUTH_ENABLED=1
API_AUTH_KEY=                              # required when the engine API is exposed (min 32 random chars)
RUNTIME_BOOTSTRAP_ENABLED=1
RUNTIME_BOOTSTRAP_DECLARE_RESULTS_QUEUE=1
RUNTIME_BOOTSTRAP_REFRESH_IOC=1
RUNTIME_BOOTSTRAP_FORCE_IOC_REFRESH=1
API_HOST=0.0.0.0
API_PORT=8000
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
NEW_EMAIL_EXCHANGE=email.new.exchange
RESULTS_QUEUE=email.results.queue
DATABASE_URL=postgresql://postgres:postgres@database:5432/email_security
REDIS_URL=redis://redis:6379/0
WEBHOOK_URLS=
EMAIL_DROP_DIR=/mnt/email_drop
ATTACHMENT_VOLUME_DIR=/mnt/attachments
PARSER_POLL_SECONDS=2
ORCHESTRATOR_CACHE_TTL_SECONDS=900
ORCHESTRATOR_PARTIAL_TIMEOUT_SECONDS=90
ORCHESTRATOR_MIN_AGENTS_FOR_DECISION=4
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview
STORYLINE_ENABLE_LLM_MITRE_ENRICHMENT=false
STORYLINE_LLM_MAX_INDICATORS_PER_PHASE=8
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=
ENABLE_VIRUSTOTAL_URL_LOOKUP=0
ENABLE_GOOGLE_SAFE_BROWSING_LOOKUP=0
ENABLE_OPENPHISH_LOOKUP=0
ENABLE_URLHAUS_LOOKUP=0
ENABLE_OTX_LOOKUP=0
ENABLE_ABUSEIPDB_LOOKUP=0
ENABLE_MALWAREBAZAAR_LOOKUP=0
ENABLE_VIRUSTOTAL_HASH_LOOKUP=0
EXTERNAL_LOOKUP_TIMEOUT_SECONDS=6
EXTERNAL_LOOKUP_MAX_INDICATORS=10
OPENPHISH_FEED_URL=https://openphish.com/feed.txt
OPENPHISH_CACHE_TTL_SECONDS=900
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1/url/
OTX_API_BASE_URL=https://otx.alienvault.com
ABUSEIPDB_API_URL=https://api.abuseipdb.com/api/v2/check
MALWAREBAZAAR_API_URL=https://mb-api.abuse.ch/api/v1/
GARUDA_API_BASE_URL=http://garuda-agent:8088
GARUDA_TIMEOUT_SECONDS=15
QUARANTINE_API_URL=http://host.docker.internal:8091/quarantine
SOC_ALERT_API_URL=http://host.docker.internal:8092/alerts
IOC_DB_PATH=/app/data/ioc_store.db
IOC_REFRESH_SECONDS=300
SANDBOX_DETONATION_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_LOCAL_DOCKER_ENABLED=0
SANDBOX_EXECUTOR_URL=
SANDBOX_EXECUTOR_SHARED_TOKEN=
SANDBOX_EXECUTOR_TIMEOUT_SECONDS=30
SANDBOX_EXECUTOR_ATTACHMENT_ROOT=/mnt/attachments
SANDBOX_ALLOW_NETWORK=0
SANDBOX_NON_ROOT_USER=65534:65534
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_PIDS_LIMIT=128
SANDBOX_MAX_DETONATIONS=5
SANDBOX_CLEANUP_STALE_SECONDS=1800
SANDBOX_ENABLE_BENIGN_BOOTSTRAP=1
SANDBOX_BENIGN_BOOTSTRAP_MAX_ROWS=5000
ACTION_SIMULATED_MODE=1
ACTION_REQUIRE_APPROVAL=1
