# SOC platform image. Core platform by default; add the phishing ML stack with
#   docker build --build-arg WITH_PHISHING_ENGINE=true -f deploy/Dockerfile .
# Base images are pinned by digest and every Python package by SHA-256 (requirements/image*.lock, generated by
# `python scripts/supply_chain.py image-lock` in this same base image): a changed upstream file fails the build.
# Refresh both together: new digest here and in scripts/supply_chain.py BASE_IMAGE, then image-lock.
FROM python:3.11-slim@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce AS builder
ARG WITH_PHISHING_ENGINE=false
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libssl-dev libzbar0 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements/ requirements/
RUN if [ "$WITH_PHISHING_ENGINE" = "true" ]; then LOCK=requirements/image-engine.lock; else LOCK=requirements/image.lock; fi \
 && pip install --no-cache-dir --require-hashes --prefix=/install -r "$LOCK"

FROM python:3.11-slim@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce
RUN apt-get update && apt-get install -y --no-install-recommends libzbar0 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1001 soc && useradd --uid 1001 --gid soc --create-home soc
# the base image's own setuptools carries old vendored copies (wheel, jaraco.context) with known CVEs: remove it, the
# locked one arrives with the packages below
RUN python -m pip uninstall -y setuptools wheel
COPY --from=builder /install /usr/local
WORKDIR /app
COPY pyproject.toml README.md ./
COPY soc_platform/ soc_platform/
COPY config/ config/
COPY scripts/ scripts/
COPY artifacts/ artifacts/
# pip is a build tool: removed from the runtime image (no package manager in production; its vendored libraries
# are not shipped). The source stays at /app (the package reads its static files, fixtures and models from there).
RUN pip install --no-cache-dir --no-deps --no-build-isolation -e . && python -m pip uninstall -y pip \
    && mkdir -p /app/data && chown -R soc:soc /app/data
USER soc
# Fail closed: an image started without settings is production (Entra sign-in, step-up MFA, encryption at rest
# required - `serve` refuses to start until they are set). A demo sets SOC_ENVIRONMENT=dev explicitly.
ENV SOC_ENVIRONMENT=prod SOC_AUTH_MODE=entra SOC_BLOB_STORE=database \
    SOC_CONNECTORS_CONFIG=/app/config/connectors.yaml SOC_RAW_PAYLOAD_DIR=/app/data/raw \
    SOC_REPORT_OUTPUT_DIR=/app/data/reports SOC_PHISHING_HOME=/app/artifacts/phishing PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 SOC_HOST=0.0.0.0 SOC_PORT=8080 SOC_API_WORKERS=4
EXPOSE 8080
# readiness: the process answers and its database does (/health/live is the liveness check). No curl in the image.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD ["python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/health/ready', timeout=5).status == 200 else 1)"]
# workers: one per CPU core given to the container (SOC_API_WORKERS); X-Forwarded-For is handled by the app
CMD ["python", "-m", "soc_platform", "serve"]
