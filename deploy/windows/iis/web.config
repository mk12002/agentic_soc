<?xml version="1.0" encoding="UTF-8"?>
<!--
  CyberDome behind IIS on the same Windows host: TLS ends here, every request is passed to the platform on
  127.0.0.1:8080 (SOC_TRUSTED_PROXIES=127.0.0.1/32,::1/128 lets the platform read the client address ARR adds in
  X-Forwarded-For). Needs the IIS URL Rewrite and Application Request Routing (ARR) modules; setup_iis.ps1 creates
  the site with this file, enables ARR's proxy and sets its timeout. The platform sends its own security headers.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <!-- the original, still-encoded path and query (an encoded "/" or "+" reaches the platform unchanged) -->
      <rules useOriginalURLEncoding="false">
        <rule name="CyberDome" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="http://127.0.0.1:8080{UNENCODED_URL}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <!-- the platform's own limit is 30 MB (an uploaded e-mail or workbook); IIS's default is 28.6 MB -->
        <requestLimits maxAllowedContentLength="31457280" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
