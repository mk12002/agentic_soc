# CyberDome settings for a Windows host. install.ps1 copies this to C:\ProgramData\CyberDome\config\cyberdome.env
# (only administrators can change it; the service account can read it). run.ps1 loads it at every start.
#   NAME=value, one per line; "#" starts a comment; an empty value means "use the default".
# Keep secrets out of this file: put each one in C:\ProgramData\CyberDome\secrets\<name> (service account: read only)
# and point NAME_FILE at it. Every SOC_* secret and every connector credential (${VAR} in connectors.yaml) accepts
# the _FILE form. Check the result with:  .\deploy\windows\cyberdome.ps1 check
# Defaults set by run.ps1 when not given here: SOC_ENVIRONMENT=prod, SOC_AUTH_MODE=entra, SOC_BLOB_STORE=database,
# SOC_HOST=127.0.0.1, SOC_PORT=8080, SOC_API_WORKERS=<CPU cores>, SOC_CONNECTOR_RATE_SHARE=<workers + 1>,
# SOC_DATA_KEY_FILE=...\secrets\data_key (created by install.ps1), SOC_CONNECTORS_CONFIG / SOC_SUPPLIERS_FILE in
# ...\config, data folders in ...\data. Every setting: docs/OPERATIONS.md.

# --- organisation ---------------------------------------------------------------------------------------------------
SOC_ORG_DOMAINS=                                # the organisation's mail domains, e.g. example.com,example.onmicrosoft.com

# --- sign-in: Entra ID (CLIENT_DEPLOYMENT_GUIDE.md section 3) ----------------------------------------------------------
SOC_ENTRA_TENANT_ID=
SOC_ENTRA_AUDIENCE=                             # api://<application id> of the platform's app registration
SOC_ENTRA_SPA_CLIENT_ID=
SOC_ENTRA_SCOPE=

# --- database: PostgreSQL 16+ with a verified TLS connection --------------------------------------------------------
# setup_postgres.ps1 (database on this host) writes the runtime connection here; a managed server: write
# postgresql+psycopg2://<user>:<password>@<host>:5432/<db>?sslmode=verify-full&sslrootcert=system to that file.
SOC_DATABASE_URL_FILE=C:\ProgramData\CyberDome\secrets\database_url
SOC_DB_RUNTIME_ROLE=soc_app                     # the role init-db grants (the platform never changes the schema)
SOC_SCHEMA_MANAGE=0                             # install.ps1 -OwnerDatabaseUrlFile / setup_postgres.ps1 run init-db

# --- reverse proxy on this host (IIS + ARR, deploy\windows\iis\web.config) ---------------------------------------------
SOC_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# --- security tools (connectors.yaml in ...\config; switch each tool on there) ---------------------------------------
SOC_CONNECTOR_MODE=live
# CROWDSTRIKE_CLIENT_ID=...                      # identifiers may stand here
# CROWDSTRIKE_CLIENT_SECRET_FILE=C:\ProgramData\CyberDome\secrets\crowdstrike_client_secret

# --- AI (optional: every figure, verdict and action works without it) ----------------------------------------------
SOC_LLM_PROVIDER=none                           # chosen in the console (AI usage -> AI integration) from then on
SOC_LLM_APPROVED_ENDPOINTS=                     # https endpoints an API-key provider may use, comma-separated
SOC_LLM_MONTHLY_TOKEN_BUDGET=50000000
# The in-house LLM gateway through its SDK (installed by install.ps1 -GatewaySdkLock); argument names as the SDK's
# documentation gives them. Tokens are entered on the AI usage screen (stored encrypted).
SOC_LLM_GATEWAY_SDK=
SOC_LLM_GATEWAY_SESSION_ARGS=
SOC_LLM_GATEWAY_MODELS_CALL=

# --- outbound TLS through an inspecting proxy: the corporate root CA as a PEM file ----------------------------------
# SSL_CERT_FILE=C:\ProgramData\CyberDome\certs\corporate-ca.pem

# --- operations ------------------------------------------------------------------------------------------------------
SOC_LOG_FORMAT=json
SOC_LOG_LEVEL=INFO
# SOC_NOTIFY_WEBHOOKS_FILE=C:\ProgramData\CyberDome\secrets\notify_webhooks   # Teams / Slack (holds credentials)
